#!/bin/sh
set +x
set -eu

# An explicitly supplied environment key works over SSH without unlocking Keychain.
if [ -z "${TYPESAFE_API_KEY:-}" ]; then
  service="${OMP_JEV_KEYCHAIN_SERVICE:-omp-typesafe}"
  keychain="${HOME}/Library/Keychains/login.keychain-db"
  if ! TYPESAFE_API_KEY=$(security find-generic-password -a "$USER" -s "$service" -w "$keychain"); then
    printf '%s\n' "Cannot read TypeSafe key from Keychain (missing, locked, or access denied): $keychain" >&2
    printf '%s\n' 'Unlock interactively: security unlock-keychain "$HOME/Library/Keychains/login.keychain-db"' >&2
    printf '%s\n' 'Or export TYPESAFE_API_KEY in this shell and rerun omp-jev; no Keychain storage is required.' >&2
    exit 1
  fi
fi
if [ -z "$TYPESAFE_API_KEY" ]; then
  printf '%s\n' 'TypeSafe API key was empty' >&2
  exit 1
fi

export TYPESAFE_API_KEY
export JEV_ROUTER_MODE="${JEV_ROUTER_MODE:-active}"
export JEV_TOOL_RISK_MODE="${JEV_TOOL_RISK_MODE:-observe}"
exec omp "$@"
